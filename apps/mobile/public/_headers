# Service workeren og siden må aldri mellomlagres lenge, ellers kommer ikke nye versjoner ut.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
# Byggefiler har hash i navnet og endres aldri.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

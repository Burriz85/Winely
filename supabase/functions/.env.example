# Lokalt: kopier til supabase/functions/.env og start med
#   npx supabase functions serve --env-file supabase/functions/.env
# I produksjon: npx supabase secrets set VMP_KEY=<nøkkel>  (VMP_BASE_URL skal ikke settes)
VMP_KEY=test-key
# Peker edge runtime-containeren mot tests/mock-vmp.mjs på verten.
# macOS/Windows: host.docker.internal. Linux: gatewayen til supabase-nettverket (ofte 172.18.0.1).
VMP_BASE_URL=http://host.docker.internal:8787
# Peker vmp-sync mot mocken for vinmonopolet.no (samme adresse som VMP_BASE_URL).
VMP_WEB_BASE_URL=http://host.docker.internal:8787
